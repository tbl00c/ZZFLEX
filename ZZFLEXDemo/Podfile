platform :ios, '15.0'
install! 'cocoapods', :generate_multiple_pod_projects => true
use_frameworks!

target 'ZZFLEXDemo' do
pod 'ZZFLEX', :path => '../'

pod 'TLKit', :git => 'https://github.com/tbl00c/TLKit.git'

pod 'Masonry', '1.1.0'
pod 'MJRefresh', '3.7.5'
pod 'XLPhotoBrowser+CoderXL', :git => 'https://github.com/tbl00c/XLPhotoBrowser.git', :tag => '1.2.2'
pod 'SDWebImage', '5.10.4'

end

# Keep every generated Pod target compatible with the SDK used by the Demo.
post_install do |installer|
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new('15.0')
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end
  end
end
